    "nat": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "int": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "rational": {
      "type": "object",
      "properties": {
        "numerator": {
          "$ref": "#/$defs/int"
        },
        "denominator": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "sign": {
      "enum": [
        -1,
        0,
        1
      ]
    },
    "polynomial": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rational"
      }
    },
    "bivariate": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/polynomial"
      }
    },
    "root_count": {
      "type": "object",
      "properties": {
