          "$ref": "#/$defs/polynomial"
        },
        "quotient": {
          "$ref": "#/$defs/polynomial"
        },
        "powerQuotient": {
          "$ref": "#/$defs/polynomial"
        },
        "exponent": {
          "$ref": "#/$defs/nat"
        },
        "bezoutLeft": {
          "$ref": "#/$defs/polynomial"
        },
        "bezoutRight": {
          "$ref": "#/$defs/polynomial"
        },
        "tail": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/polynomial"
          }
        },
        "quotients": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/polynomial"
          }
        },
        "last": {
          "$ref": "#/$defs/rational"
        }
      },
      "required": [
        "representative",
        "quotient",
        "powerQuotient",
        "exponent",
        "bezoutLeft",
        "bezoutRight",
        "tail",
        "quotients",
        "last"
      ],
      "additionalProperties": false
